{
  "info": {
    "name": "Neon Arena Leaderboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Submit score (absolute rating)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"PostmanPlayer\",\n  \"mode\": \"blitz\",\n  \"rating\": 2100\n}"
        }
      }
    },
    {
      "name": "Submit score (delta)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"PostmanPlayer\",\n  \"mode\": \"blitz\",\n  \"delta\": 15\n}"
        }
      }
    },
    {
      "name": "Submit batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores/batch",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "batch"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"username\": \"BatchA\",\n    \"mode\": \"bullet\",\n    \"rating\": 1800\n  },\n  {\n    \"username\": \"BatchB\",\n    \"mode\": \"rapid\",\n    \"delta\": -12\n  }\n]"
        }
      }
    },
    {
      "name": "Top 50 - blitz",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaderboard/blitz?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leaderboard",
            "blitz"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "Top 10 - bullet",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaderboard/bullet?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leaderboard",
            "bullet"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Top 50 - rapid",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaderboard/rapid?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leaderboard",
            "rapid"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "Find my rank (player + neighbours)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leaderboard/blitz/player/PostmanPlayer?radius=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leaderboard",
            "blitz",
            "player",
            "PostmanPlayer"
          ],
          "query": [
            {
              "key": "radius",
              "value": "3"
            }
          ]
        }
      }
    },
    {
      "name": "Player profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/players/PostmanPlayer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players",
            "PostmanPlayer"
          ]
        }
      }
    },
    {
      "name": "Score history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/players/PostmanPlayer/history?mode=blitz&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "players",
            "PostmanPlayer",
            "history"
          ],
          "query": [
            {
              "key": "mode",
              "value": "blitz"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Which API node answered",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/instance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "instance"
          ]
        }
      }
    },
    {
      "name": "LB status (backends, connections)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/lb/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lb",
            "status"
          ]
        }
      }
    },
    {
      "name": "LB health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    }
  ]
}